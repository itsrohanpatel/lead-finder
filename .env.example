# Prospector-AI Environment Variables
# Copy this file to .env and insert your API keys

# Apollo.io API Keys (Paid or Trial plan with API search enabled)
# Option A: Single Key
APOLLO_API_KEY=your_primary_key_here

# Option B: Comma-separated list for automatic rotation & quota scaling (600/day per account)
# APOLLO_API_KEYS=key1,key2,key3

# Option C: Numbered keys (e.g. for GitHub Secrets or distinct accounts)
# APOLLO_API_KEY_1=key_account_1
# APOLLO_API_KEY_2=key_account_2
# APOLLO_API_KEY_3=key_account_3

# Optional Search API Keys (Not required - zero-config Yahoo/DuckDuckGo is default)
SERPER_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
APIFY_API_TOKEN=
