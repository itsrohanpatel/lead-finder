# Prospector-AI Environment Variables
# Copy this file to .env and insert your API keys

# Apollo.io API Key (Paid or Trial plan with API search enabled)
# Enables instant company employee roster extraction and automatic unmasking
APOLLO_API_KEY=your_apollo_api_key_here

# Optional Search API Keys (Not required - zero-config Yahoo/DuckDuckGo is default)
SERPER_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
APIFY_API_TOKEN=
